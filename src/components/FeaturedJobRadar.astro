
---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const isSpanish = lang === 'es';
---

<section id="work" class="featured-system" aria-labelledby="job-radar-title">
  <header class="system-introduction">
    <div>
      <p class="section-label">
        {isSpanish ? '01 / SISTEMA DESTACADO' : '01 / FEATURED SYSTEM'}
      </p>
      <h2 id="job-radar-title">Job Radar</h2>
    </div>
    <div class="system-summary">
      <p class="system-problem">
        {isSpanish
          ? 'Las ofertas de empleo externas necesitan una estructura coherente para poder compararse, filtrarse y ordenarse.'
          : 'External job offers need a consistent structure before they can be compared, filtered and ranked.'}
      </p>
      <p>
        {isSpanish
          ? 'Job Radar recopila ofertas de empleo externas, normaliza sus datos y elimina duplicados mediante la URL. La aplicación expone resultados estructurados a través de una API REST con FastAPI, filtros y paginación. Las reglas de puntuación deterministas mantienen un orden predecible.'
          : 'Job Radar collects external job offers, normalizes their data and removes duplicates by URL. The application exposes structured results through a FastAPI REST API with filtering and pagination, while deterministic scoring rules keep ranking behavior predictable.'}
      </p>
    </div>
  </header>

  <div class="system-explanation">
    <figure class="system-overview">
      <figcaption>
        <span class="section-label">
          {isSpanish ? 'VISTA GENERAL DEL SISTEMA' : 'SYSTEM OVERVIEW'}
        </span>
        <span class="overview-caption">
          {isSpanish
            ? 'Responsabilidades lógicas, no orden de ejecución.'
            : 'Logical responsibilities, not execution order.'}
        </span>
      </figcaption>
      <p class="system-input">
        {isSpanish ? 'Ofertas externas' : 'External offers'}
      </p>
      <dl class="system-stages">
        <div class="system-stage">
          <dt>{isSpanish ? 'Preparar' : 'Prepare'}</dt>
          <dd>{isSpanish ? 'ingesta' : 'ingestion'}</dd>
          <dd>{isSpanish ? 'normalización' : 'normalization'}</dd>
          <dd>{isSpanish ? 'eliminación de duplicados por URL' : 'URL deduplication'}</dd>
        </div>
        <div class="system-stage">
          <dt>{isSpanish ? 'Persistir' : 'Persist'}</dt>
          <dd>PostgreSQL</dd>
        </div>
        <div class="system-stage">
          <dt>{isSpanish ? 'Servir' : 'Serve'}</dt>
          <dd>REST API</dd>
          <dd>{isSpanish ? 'filtrado' : 'filtering'}</dd>
          <dd>{isSpanish ? 'paginación' : 'pagination'}</dd>
          <dd>{isSpanish ? 'puntuación determinista' : 'deterministic scoring'}</dd>
          <dd>frontend</dd>
        </div>
      </dl>
    </figure>

    <dl class="system-notes">
      <div>
        <dt>{isSpanish ? 'IDENTIDAD POR URL' : 'URL IDENTITY'}</dt>
        <dd>
          {isSpanish
            ? 'Las ofertas duplicadas se identifican mediante la URL de origen.'
            : 'Duplicate offers are identified through their source URL.'}
        </dd>
      </div>
      <div>
        <dt>{isSpanish ? 'PUNTUACIÓN DETERMINISTA' : 'DETERMINISTIC SCORING'}</dt>
        <dd>
          {isSpanish
            ? 'Las reglas de puntuación definidas hacen que la clasificación sea predecible y reproducible.'
            : 'Defined scoring rules keep ranking behavior predictable and repeatable.'}
        </dd>
      </div>
      <div>
        <dt>{isSpanish ? 'EVIDENCIAS DE INGENIERÍA' : 'ENGINEERING EVIDENCE'}</dt>
        <dd>OpenAPI · pytest · GitHub Actions</dd>
      </div>
    </dl>
  </div>

  <footer class="system-footer">
    <dl class="system-metadata">
      <div>
        <dt>{isSpanish ? 'APLICACIÓN' : 'APPLICATION'}</dt>
        <dd>Python 3.12 · FastAPI</dd>
      </div>
      <div>
        <dt>{isSpanish ? 'DATOS' : 'DATA'}</dt>
        <dd>PostgreSQL · SQLAlchemy · Alembic</dd>
      </div>
      <div>
        <dt>{isSpanish ? 'DESPLIEGUE' : 'DELIVERY'}</dt>
        <dd>Docker</dd>
      </div>
    </dl>
    <div class="system-links">
      <a href={isSpanish ? '/es/projects/job-radar/' : '/projects/job-radar'}>
        {isSpanish
          ? 'Leer el caso de estudio técnico →'
          : 'Read the engineering case study →'}
      </a>
      <a
        class="live-link"
        href="https://job-radar-bonw.onrender.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        {isSpanish ? 'Abrir proyecto en vivo →' : 'Open live project →'}
      </a>
    </div>
  </footer>
</section>

<style>
  .featured-system {
    padding-block: var(--space-12) var(--space-16);
    border-block-start: 1px solid var(--color-border);
  }

  .system-introduction,
  .system-explanation {
    display: grid;
    gap: var(--space-8);
  }

  .section-label,
  .system-notes dt,
  .system-metadata dt {
    color: var(--color-primary);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
  }

  .section-label {
    display: block;
    margin-block-end: var(--space-3);
  }

  h2 {
    margin: 0;
    letter-spacing: -0.025em;
  }

  .system-summary {
    max-inline-size: 60ch;
  }

  .system-summary p:last-child {
    margin: 0;
  }

  .system-problem {
    font-size: var(--font-size-body-large);
    margin-block-end: var(--space-6);
  }

  .system-explanation {
    margin-block: var(--space-8) var(--space-6);
  }

  figure,
  dl,
  dd {
    margin: 0;
  }

  .overview-caption {
    display: block;
    font-size: var(--font-size-small);
  }

  .system-input {
    margin-block: var(--space-6) var(--space-4);
    font-weight: var(--font-weight-semibold);
  }

  .system-stages {
    display: grid;
    gap: var(--space-8);
    padding-inline-start: var(--space-4);
    border-inline-start: 1px solid var(--color-border);
  }

  .system-stage dt {
    margin-block-end: var(--space-1);
    color: var(--color-primary);
    font-size: var(--font-size-body-large);
    font-weight: var(--font-weight-semibold);
  }

  .system-stage dd + dd {
    margin-block-start: var(--space-1);
  }

  .system-notes {
    display: grid;
    align-content: start;
    gap: var(--space-6);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--color-border);
  }

  .system-notes dt,
  .system-metadata dt {
    margin-block-end: var(--space-1);
  }

  .system-notes dd {
    max-inline-size: 40ch;
  }

  .system-footer {
    display: grid;
    gap: var(--space-6);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }

  .system-metadata {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-8);
  }

  .system-footer a {
    justify-self: start;
    display: inline-flex;
    align-items: flex-start;
    min-block-size: 3rem;
    font-weight: var(--font-weight-semibold);
  }

  .system-links {
    display: grid;
    align-content: start;
    min-inline-size: 0;
    gap: var(--space-1);
  }

  .system-links .live-link {
    font-weight: var(--font-weight-regular);
  }

  @media (min-width: 48rem) {
    .featured-system {
      padding-block: var(--space-16);
    }

    .system-introduction {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-12);
    }

    .system-explanation {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-12);
      margin-block: var(--space-12) var(--space-8);
    }

    .system-notes {
      padding-block-start: 0;
      padding-inline-start: var(--space-6);
      border-block-start: 0;
      border-inline-start: 1px solid var(--color-border);
    }
  }

  @media (min-width: 64rem) {
    .system-explanation {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: var(--space-16);
    }

    .system-stages {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.25fr);
      gap: var(--space-6);
      padding-inline-start: 0;
      padding-block-start: var(--space-4);
      border-inline-start: 0;
      border-block-start: 1px solid var(--color-border);
    }

    .system-footer {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
      gap: var(--space-6);
    }

    .system-metadata {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) minmax(0, 0.55fr);
      gap: var(--space-4);
    }
  }
</style>
