
---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const isSpanish = lang === 'es';

const links = isSpanish
  ? [
      { href: '/es/#work', label: 'Proyectos' },
      { href: '/es/#services', label: 'Servicios' },
      { href: '/es/#about', label: 'Sobre mí' },
      { href: '/es/#contact', label: 'Contacto' },
    ]
  : [
      { href: '/#work', label: 'Work' },
      { href: '/#services', label: 'Services' },
      { href: '/#about', label: 'About' },
      { href: '/#contact', label: 'Contact' },
    ];

const cvHref = isSpanish
  ? '/sebastian-gaggero-cv-es.pdf'
  : '/sebastian-gaggero-cv-en.pdf';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={isSpanish ? '/es/' : '/'}>
      Sebastian Gaggero
    </a>

    <nav aria-label={isSpanish ? 'Navegación principal' : 'Primary navigation'}>
      <ul role="list">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <div class="language-switch" aria-label={isSpanish ? 'Idioma' : 'Language'}>
        
      <a href="/" lang="en" aria-current={isSpanish ? undefined : 'page'}>EN</a>
      <span aria-hidden="true">/</span>
      {
        isSpanish ? (
          <a href="/es/" lang="es" aria-current="page">ES</a>
        ) : Astro.url.pathname === '/projects/job-radar' ||
          Astro.url.pathname === '/projects/job-radar/' ? (
          <span lang="es" aria-disabled="true">ES</span>
        ) : (
          <a href="/es/" lang="es">ES</a>
        )
      }

      </div>

      <a class="cv-link" href={cvHref} download>
        {isSpanish ? 'Descargar CV' : 'Download CV'}
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    margin-block-end: var(--space-8);
    border-block-end: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-2);
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-text);
    font-size: var(--font-size-body-large);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  nav {
    grid-column: 1 / -1;
    grid-row: 2;
    max-inline-size: 100%;
  }

  .header-actions {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-3);
  }

  .language-switch {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-small);
    white-space: nowrap;
  }

  .language-switch a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .language-switch a[aria-current='page'] {
    font-weight: var(--font-weight-bold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cv-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-text);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-regular);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }

  .cv-link:hover,
  .language-switch a:hover {
    color: var(--color-primary);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-text);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-regular);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  @media (min-width: 48rem) {
    .header-inner {
      row-gap: var(--space-1);
      column-gap: var(--space-6);
      padding-block: var(--space-6);
    }

    ul {
      column-gap: var(--space-6);
    }

    nav a {
      font-size: var(--font-size-body);
    }
  }

  @media (min-width: 64rem) {
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto auto;
    }

    nav {
      grid-column: 2;
      grid-row: 1;
    }

    .header-actions {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
