---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const isSpanish = lang === 'es';
---

<section id="contact" class="contact" aria-labelledby="contact-heading">
  <h2 id="contact-heading">
    {isSpanish ? '07 / CONTACTO' : '07 / CONTACT'}
  </h2>

  <div class="contact-content">
    <p>
      {isSpanish
        ? 'Si buscas a alguien para desarrollar soluciones backend con Python o necesitas ayuda con sistemas backend, automatización o integraciones, puedes contactarme a través de LinkedIn.'
        : 'If you’re hiring for Python backend work or need help with backend systems, automation or integrations, LinkedIn is the best place to reach me.'}
    </p>

    <div class="contact-links">
      <a
        href="https://www.linkedin.com/in/sebastiangaggero/"
        target="_blank"
        rel="noopener noreferrer"
      >
        {isSpanish ? 'Contactar por LinkedIn →' : 'Contact on LinkedIn →'}
      </a>

      <a
        href="https://github.com/SrMetus"
        target="_blank"
        rel="noopener noreferrer"
      >
        {isSpanish ? 'Ver GitHub →' : 'View GitHub →'}
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-12) var(--space-16);
    border-block-start: 1px solid var(--color-border);
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    margin-block-end: var(--space-8);
    color: var(--color-primary);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-body);
    letter-spacing: 0.04em;
  }

  .contact-content {
    display: grid;
    gap: var(--space-6);
  }

  p {
    max-inline-size: 55ch;
    font-size: var(--font-size-body-large);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  a {
    display: inline-flex;
    align-items: center;
    min-block-size: 3rem;
    color: var(--color-primary);
    text-decoration: underline;
  }

  @media (min-width: 48rem) {
    .contact-links {
      flex-direction: row;
      flex-wrap: wrap;
      column-gap: var(--space-8);
    }
  }

  @media (min-width: 64rem) {
    .contact-content {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      column-gap: var(--space-12);
      align-items: start;
    }

    .contact-links {
      flex-direction: column;
    }
  }
</style>