---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  lang?: 'en' | 'es';
}

const { title, lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <Header lang={lang} />
    <slot />
  </body>
</html>